---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-frame">
        <img class="footer-logo-image" src="/inthefifty.jpg" alt="In The Fifty logo" loading="lazy" decoding="async" />
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#studio50">Studio50</a></li>
        <li><a href="#support">Support</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} IN THE FIFTY. All rights reserved.</p>
    <p class="footer-disclaimer">
      <span>American Made First</span>
      <span>Built to champion businesses across all fifty states.</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: #9aabcc;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.25rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
  }

  /* Brand */
  .footer-logo-frame {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .footer-logo-image {
    display: block;
    width: min(100%, 9rem);
    border-radius: 1.2rem;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.22);
  }

  /* Nav */
  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }

  .footer-nav a {
    font-size: 0.85rem;
    font-weight: 500;
    color: #9aabcc;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--color-white);
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1rem 1.25rem;
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
  }

  .footer-disclaimer {
    color: #5a6888;
  }

  .footer-disclaimer span {
    display: block;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
