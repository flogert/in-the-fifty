---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'Studio50', href: '#studio50' },
  { label: 'Support', href: '#support' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="IN THE FIFTY Home">
      <span class="logo-text">IN THE <strong>FIFTY</strong></span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="#contact" class="cta-btn header-cta">Reach Out</a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-navigation" aria-label="Mobile navigation" hidden>
    <ul class="mobile-nav-list">
      {navLinks.map((link) => (
        <li><a href={link.href} class="mobile-nav-link">{link.label}</a></li>
      ))}
      <li><a href="#contact" class="cta-btn mobile-cta">Reach Out</a></li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header') as HTMLElement | null;
  const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
  const mobileNav = document.querySelector('.mobile-nav') as HTMLElement | null;
  const mobileLinks = document.querySelectorAll('.mobile-nav-link, .mobile-cta');

  const syncHeaderHeight = () => {
    if (!header) return;
    document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
  };

  const setMenuState = (isOpen: boolean) => {
    if (!toggle || !mobileNav) return;

    mobileNav.classList.toggle('open', isOpen);
    mobileNav.hidden = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  };

  syncHeaderHeight();
  window.addEventListener('resize', () => {
    syncHeaderHeight();
    if (window.innerWidth > 768) {
      setMenuState(false);
    }
  });

  toggle?.addEventListener('click', () => {
    const isOpen = !(mobileNav?.classList.contains('open'));
    setMenuState(isOpen);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNav?.classList.contains('open')) {
      setMenuState(false);
      toggle?.focus();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 300;
    background: rgba(18, 24, 48, 0.92);
    color: var(--color-white);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.875rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Logo */
  .logo {
    display: flex;
    flex-direction: row;
    line-height: 1.1;
    flex-shrink: 0;
    align-items: baseline;
  }

  .logo-text {
    font-size: 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    letter-spacing: 0.16em;
    color: var(--color-white);
    text-transform: uppercase;
  }

  .logo-text strong {
    color: var(--color-red);
    font-weight: 900;
  }

  /* Desktop nav */
  .nav {
    flex: 1;
  }

  .nav-list {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ccd2e0;
    transition: color 0.2s;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    color: var(--color-white);
    border-bottom-color: var(--color-red);
  }

  /* CTA button */
  .cta-btn {
    background: var(--color-red);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.16);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: background 0.2s, transform 0.1s, box-shadow 0.2s;
    display: inline-block;
    box-shadow: 0 12px 24px rgba(178, 34, 52, 0.22);
  }

  .cta-btn:hover {
    background: #8b1a27;
    transform: translateY(-1px);
  }

  .site-header,
  .mobile-nav {
    backdrop-filter: blur(10px);
  }

  /* Hamburger */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    cursor: pointer;
    padding: 0.65rem;
    margin-left: auto;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-white);
  }

  /* Mobile nav */
  .mobile-nav {
    position: fixed;
    top: calc(var(--header-height, 72px) + 0.5rem);
    left: 1rem;
    right: 1rem;
    z-index: 220;
    background: rgba(18, 24, 48, 0.98);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 1.25rem;
    box-shadow: 0 28px 56px rgba(0, 0, 0, 0.32);
    opacity: 0;
    transform: translateY(-0.5rem);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .mobile-nav.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-list {
    padding: 1rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-link {
    font-size: 1rem;
    color: #ccd2e0;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: block;
    padding: 0.8rem 0.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .mobile-cta {
    margin-top: 0.5rem;
    text-align: center;
    width: 100%;
  }

  @media (max-width: 768px) {
    .nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (min-width: 769px) {
    .header-inner {
      padding: 0.75rem 1.25rem;
      gap: 1.5rem;
    }

    .logo-text {
      font-size: 1.38rem;
    }

    .mobile-nav {
      display: none !important;
    }
  }
</style>
